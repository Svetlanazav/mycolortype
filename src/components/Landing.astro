<!-- Testimonials are not rendered. The two entries in Comments.astro carry
     invented names, job titles, star ratings and stock-photo avatars; publishing
     those as genuine customer reviews is not something to ship by accident.
     The component is intact — restore this section by re-adding
     `import CommentSection from "../components/Comments.astro";` above, putting
     `<CommentSection />` back here, and restoring the "Reviews" nav link — once
     the quotes are real. -->

<!-- FAQ -->
<section class="py-16 px-4 bg-white">
  <div class="container mx-auto max-w-2xl">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold text-primary-plum mb-3">Common questions</h2>
      <p class="text-primary-mauve text-base md:text-lg">Everything you need to know before you start.</p>
    </div>
    <div class="faq-list">

      <details class="faq-item">
        <summary class="faq-question">
          What is color season analysis?
          <span class="faq-chevron" aria-hidden="true">+</span>
        </summary>
