---
import ImageUploadContainer from "../components/ImageUploadContainer";
import { withBase } from "../scripts/urls";

const homeHref = withBase("");
const blogHref = withBase("blog");
---

<!-- Hero Section — the header sits inside this gradient rather than on a bar
     of its own, so it reads as part of the page instead of a separate block. -->
<div class="bg-linear-to-r from-primary-sand to-white">
  <header class="relative z-50 py-5 text-primary-plum">
    <div class="container mx-auto flex justify-between items-center gap-4 px-6">
      <a href={homeHref} class="text-2xl font-bold tracking-tight">MyColorType</a>

      <nav class="flex items-center gap-6">
        <button
          id="menuToggle"
          type="button"
          class="menu-toggle"
          aria-controls="siteNav"
          aria-expanded="false"
          aria-label="Open navigation menu"
        >
          <span class="menu-bars" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </button>

        <ul id="siteNav" class="site-nav font-medium md:gap-6 lg:gap-8">
          <li>
            <a href="#startanalysis" class="nav-link">How to start</a>
          </li>
          <li>
            <a href="#coloranalysis" class="nav-link">Color Analysis</a>
          </li>
          <li><a href="#features" class="nav-link">Features</a></li>
          <li>
            <a href={blogHref} class="nav-link">Blog</a>
          </li>
        </ul>

        <a
          href="#imageupload"
          class="hidden md:inline-block text-base font-semibold text-accent-gold-deep border-b-2 border-accent-gold-deep/40 hover:border-accent-gold-deep transition-colors"
        >
          Get Started
        </a>
      </nav>
    </div>
  </header>

  <section
    class="container mx-auto px-6 pb-12 pt-2 relative overflow-hidden md:overflow-visible"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <!-- Left Column -->
      <div
        class="space-y-6 pb-5 pt-2 sm:pb-8 sm:pt-24 md:pb-8 md:pt-8 relative z-10 hero-animate"
      >
        <!-- Trust badges -->
        <div class="flex flex-wrap gap-2">
          <span class="hero-badge"><svg class="badge-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.5 3.5L13 4.5" /></svg>Free</span>
          <span class="hero-badge"><svg class="badge-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.5 3.5L13 4.5" /></svg>AI-powered</span>
          <span class="hero-badge"><svg class="badge-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.5 3.5L13 4.5" /></svg>Instant results</span>
        </div>

        <h1
          class="font-display text-balance text-5xl/[0.9] font-normal tracking-tight text-primary-plum md:text-6xl/[0.9] lg:text-8xl/[0.9]"
        >
          Discover Your<br />
          Perfect<br />
          Color Palette
        </h1>
        <p class="text-primary-mauve text-lg max-w-md lg:text-2xl text-pretty">
          Transform your style with professional color analysis. Learn which
          colors make you look and feel your absolute best.
        </p>
        <a
          href="#imageupload"
          class="block sm:inline-block text-center px-7 py-4 text-white rounded-full text-lg font-semibold transition-colors bg-linear-to-r from-accent-gold-deep to-primary-plum hover:from-primary-mauve hover:to-primary-plum"
          >GET STARTED</a
        >
      </div>
      <!-- Right Column - Image (bg on mobile) -->
      <!-- Mobile version -->
      <div class="absolute inset-0 block md:hidden z-0">
        <img
          src="/mycolortype/pics/AI_color.jpg"
          alt=""
          aria-hidden="true"
          width="1208"
          height="1074"
          decoding="async"
          class="absolute inset-0 h-auto transform scale-x-[-1] translate-x-1/2 opacity-50 m-auto"
        />
      </div>
      <!-- Desktop version -->
      <div class="hidden md:block">
        <img
          src="/mycolortype/pics/AI_color.jpg"
          alt="Face with colour analysis guides and a matching palette"
          width="1208"
          height="1074"
          fetchpriority="high"
          decoding="async"
          class="w-full h-auto rounded-3xl"
        />
      </div>
    </div>
  </section>
</div>
<!-- Custom shape divider -->
<div class="custom-shape-divider-top-1735495376">
  <svg
    data-name="Layer 1"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1200 120"
    preserveAspectRatio="none"
  >
    <defs>
      <linearGradient id="divider-gradient-a" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#F5E6E8"></stop>
        <stop offset="100%" stop-color="#FFFFFF"></stop>
      </linearGradient>
    </defs>
    <path
      d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
      class="shape-fill"
      fill="url(#divider-gradient-a)"></path>
  </svg>
</div>

<!-- Journey section -->
<div class="mx-auto mt-12 max-w-7xl px-6 sm:mt-24 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-base/7 font-semibold text-accent-gold-deep">
      Your Journey to Confidence
    </h2>
    <p
      class="mt-2 text-pretty text-4xl font-semibold tracking-tight text-primary-plum sm:text-5xl lg:text-balance"
    >
      Are you tired of wasting money on clothes that never get worn?
    </p>
    <p class="mt-6 text-pretty text-lg/8 text-primary-mauve">
      When you wear the right colors, everything changes. It's not just about
      looking good—it's about feeling amazing
    </p>
  </div>
  <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl">
    <dl
      class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-2 lg:gap-y-16"
    >
      <div class="relative pl-16">
        <dt class="text-base/7 font-semibold text-primary-plum">
          <div
            class="absolute left-0 top-0 flex size-10 items-center justify-center rounded-lg bg-accent-gold-deep"
          >
            <svg
              class="size-6 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z"
              ></path>
            </svg>
          </div>
          Confidence
        </dt>
        <dd class="mt-2 text-base/7 text-primary-mauve">
          You'll walk into every room feeling radiant
        </dd>
      </div>

      <div class="relative pl-16">
        <dt class="text-base/7 font-semibold text-primary-plum">
          <div
            class="absolute left-0 top-0 flex size-10 items-center justify-center rounded-lg bg-accent-gold-deep"
          >
            <svg
              class="size-6 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
              ></path>
            </svg>
          </div>
          Authenticity
        </dt>
        <dd class="mt-2 text-base/7 text-primary-mauve">
          Your wardrobe will reflect your personality and values.
        </dd>
      </div>

      <div class="relative pl-16">
        <dt class="text-base/7 font-semibold text-primary-plum">
          <div
            class="absolute left-0 top-0 flex size-10 items-center justify-center rounded-lg bg-accent-gold-deep"
          >
            <svg
              class="size-6 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
              ></path>
            </svg>
          </div>
          Freedom
        </dt>
        <dd class="mt-2 text-base/7 text-primary-mauve">
          No more second-guessing or settling for 'good enough.'
        </dd>
      </div>
      <div class="relative pl-16">
        <dt class="text-base/7 font-semibold text-primary-plum">
          <div
            class="absolute left-0 top-0 flex size-10 items-center justify-center rounded-lg bg-accent-gold-deep"
          >
            <svg
              class="size-6 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
              ></path>
            </svg>
          </div>
          Transformation
        </dt>
        <dd class="mt-2 text-base/7 text-primary-mauve">
          Use your palette to shop smarter and dress with ease.
        </dd>
      </div>
    </dl>
  </div>
</div>

<!-- Steps section -->
<section
  id="startanalysis"
  class="bg-linear-to-r from-primary-sand to-white text-center py-16 px-4 relative"
>
  <div class="container mx-auto max-w-4xl">
    <h2 class="text-3xl md:text-4xl font-bold text-primary-plum mb-4">
      Colors are powerful—let’s find the ones that empower you
    </h2>
    <p class="text-primary-mauve text-base md:text-lg mb-12 max-w-2xl mx-auto">
      Analyze colors that define you, your personality and your style.
    </p>
    <div class="grid md:grid-cols-3 gap-8 text-left max-w-3xl mx-auto">

      <!-- Step 1 -->
      <div class="bg-primary-sand rounded-lg p-6 shadow-sm transition-transform hover:scale-105">
        <div class="flex items-center gap-3 mb-4">
          <div class="step-icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z" />
            </svg>
          </div>
          <span class="text-accent-gold-deep font-bold text-sm uppercase tracking-widest">Step 1</span>
        </div>
        <h3 class="font-semibold text-primary-plum mb-2">Take your photo</h3>
        <p class="text-primary-mauve text-sm leading-relaxed">
          A clear selfie in natural light works best. Make sure your face and hair are fully visible.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="bg-primary-sand rounded-lg p-6 shadow-sm transition-transform hover:scale-105">
        <div class="flex items-center gap-3 mb-4">
          <div class="step-icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
            </svg>
          </div>
          <span class="text-accent-gold-deep font-bold text-sm uppercase tracking-widest">Step 2</span>
        </div>
        <h3 class="font-semibold text-primary-plum mb-2">Upload &amp; analyse</h3>
        <p class="text-primary-mauve text-sm leading-relaxed">
          Upload your photo or use your camera. Our AI analyses your skin, hair and eye colors instantly.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="bg-primary-sand rounded-lg p-6 shadow-sm transition-transform hover:scale-105">
        <div class="flex items-center gap-3 mb-4">
          <div class="step-icon-wrap">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42" />
            </svg>
          </div>
          <span class="text-accent-gold-deep font-bold text-sm uppercase tracking-widest">Step 3</span>
        </div>
        <h3 class="font-semibold text-primary-plum mb-2">Get your palette</h3>
        <p class="text-primary-mauve text-sm leading-relaxed">
          Receive your color season and a full personalized palette to elevate your everyday style.
        </p>
      </div>

    </div>
  </div>
  <div class="custom-shape-divider-top-1735509263">
    <svg
      data-name="Layer 1"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
    >
      <path
        d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z"
        class="shape-fill"></path>
    </svg>
  </div>
</section>
<div class="custom-shape-divider-top-1735495376">
  <svg
    data-name="Layer 1"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1200 120"
    preserveAspectRatio="none"
  >
    <defs>
      <linearGradient id="divider-gradient-b" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#F5E6E8"></stop>
        <stop offset="100%" stop-color="#FFFFFF"></stop>
      </linearGradient>
    </defs>
    <path
      d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
      class="shape-fill"
      fill="url(#divider-gradient-b)"></path>
  </svg>
</div>
<!-- ImageUploadContainer -->
<section id="imageupload" class="py-16 px-4">
  <div class="container mx-auto max-w-4xl">
    <hgroup class="text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-primary-plum mb-4">
        Discover Your Perfect Palette
      </h2>
      <p class="text-primary-mauve text-base md:text-lg mb-2 max-w-2xl mx-auto">
        Analyze colors that define you, your personality and your style.
      </p>
    </hgroup>
    <ImageUploadContainer client:load />
  </div>
</section>

<!-- What is color analysis -->
<div id="coloranalysis" class="bg-white py-24 md:pt-16 bottom-auto">
  <div class="relative isolate">
    <div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
      <h2
        class="text-pretty text-4xl font-semibold tracking-tight text-center text-primary-plum sm:text-5xl"
      >
        What Is Color Analysis?
      </h2>
      <div
        class="mx-auto flex max-w-2xl flex-col gap-16 px-6 py-16 ring-accent-rose sm:rounded-3xl sm:p-8 lg:mx-0 lg:max-w-none lg:flex-row lg:items-center lg:py-20 xl:gap-x-20 xl:px-20"
      >
        <img
          class="h-96 w-full flex-none rounded-2xl object-cover shadow-xl lg:aspect-square lg:h-auto lg:max-w-sm"
          src="/mycolortype/pics/happywomen.jpeg"
          alt="Happy woman smiling, surrounded by bright colors"
          width="896"
          height="1152"
          loading="lazy"
          decoding="async"
        />
        <div class="w-full flex-auto">
          <p class="mt-6 text-pretty text-lg/8 text-primary-mauve">
            Color analysis is a personalized approach to uncover the shades and
            tones that best complement your natural features—your skin tone, eye
            color, and hair.
          </p>
          <div class="mt-10 flex">
            <a
              href={blogHref}
              class="text-sm/6 font-semibold text-accent-gold-deep"
            >
              Read more in our blog <svg class="cta-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h11M9.5 4l4 4-4 4" /></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div
      class="absolute inset-x-0 -top-16 -z-10 flex transform-gpu justify-center overflow-hidden blur-3xl"
      aria-hidden="true"
    >
      <div
        class="aspect-[1318/752] w-[82.375rem] flex-none bg-gradient-to-r from-primary-sand to-accent-rose opacity-25"
        style="clip-path: polygon(73.6% 51.7%, 91.7% 11.8%, 100% 46.4%, 97.4% 82.2%, 92.5% 84.9%, 75.7% 64%, 55.3% 47.5%, 46.5% 49.4%, 45% 62.9%, 50.3% 87.2%, 21.3% 64.1%, 0.1% 100%, 5.4% 51.1%, 21.4% 63.9%, 58.9% 0.2%, 73.6% 51.7%)"
      >
      </div>
    </div>
  </div>
</div>

<!-- How we do it -->
<section
  id="features"
  class="py-16 px-4 md:-top-64 bg-linear-to-r from-primary-sand to-white"
>
  <div class="container mx-auto my-4 max-w-6xl">
